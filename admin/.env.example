# Copy to .env.local for local development.
# In production set these in the Vercel dashboard: Settings → Environment Variables.

# ---- Firebase web config (public — shipped in the browser bundle) ----
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ---- Server-side secrets (never prefix with VITE_) ----
# The entire service-account JSON on one line.
# Locally you can skip this and use admin/.secrets/firebase-admin.json instead.
FIREBASE_SERVICE_ACCOUNT=

# ---- Google Drive ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=
