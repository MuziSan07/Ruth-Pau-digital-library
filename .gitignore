# ---- Secrets: never commit ----
**/.secrets/
*firebase-adminsdk*.json
*service-account*.json
.env
.env.*
!.env.example

# ---- Node / React admin ----
node_modules/
dist/
.vercel/
npm-debug.log*
*.log

# ---- Flutter / Dart ----
.dart_tool/
.packages
build/
.flutter-plugins
.flutter-plugins-dependencies
mobile/android/local.properties
mobile/android/key.properties
mobile/**/*.jks
mobile/**/*.keystore
mobile/ios/Pods/

# Firebase mobile config is deliberately COMMITTED, not ignored: the
# google-services Gradle plugin fails the build without it, so a fresh clone
# could not produce an APK. It holds no secrets — the same identifiers are in
# mobile/lib/firebase_options.dart and ship inside every APK. Access is
# controlled by Firestore rules, not by hiding these values.
mobile/ios/Runner/GoogleService-Info.plist

# ---- OS / editors ----
Thumbs.db
.DS_Store
.idea/
.vscode/
